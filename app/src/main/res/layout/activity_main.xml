<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabInpaint"
            style="@style/TabBtn"
            android:text="Inpaint" />

        <Button
            android:id="@+id/btnTabCreate"
            style="@style/TabBtn"
            android:text="Img2Img" />

        <Button
            android:id="@+id/btnTabText"
            style="@style/TabBtn"
            android:text="Text" />
    </LinearLayout>

    <com.hcode91.stableandroid.MaskCanvasView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <!-- Canvas tools -->
    <HorizontalScrollView
        android:id="@+id/rowTools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="2dp">

            <Button android:id="@+id/btnImage" style="@style/ToolBtn" android:text="Image" />
            <Button android:id="@+id/btnBrush" style="@style/ToolBtn" android:text="Brush" />
            <Button android:id="@+id/btnUndo" style="@style/ToolBtn" android:text="Undo" />
            <Button android:id="@+id/btnClear" style="@style/ToolBtn" android:text="Clear" />
            <Button android:id="@+id/btnInvert" style="@style/ToolBtn" android:text="Invert" />
            <Button android:id="@+id/btnFit" style="@style/ToolBtn" android:text="Fit" />
            <Button android:id="@+id/btnToggle" style="@style/ToolBtn" android:text="Result" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/rowBrush"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E1E1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Brush"
            android:textColor="#BBBBBB" />

        <SeekBar
            android:id="@+id/seekBrush"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="200"
            android:min="8"
            android:progress="60" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.9"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Generate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnGenerate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="Inpaint" />

                <Button
                    android:id="@+id/btnCancel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Cancel" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/txtStatus"
                style="@style/Label"
                android:text="No model loaded" />

            <LinearLayout
                android:id="@+id/rowResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◀" />

                <TextView
                    android:id="@+id/txtResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▶" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSave"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Save" />

                <Button
                    android:id="@+id/btnUseResult"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Keep &amp; continue" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkAutoSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Save every result to Pictures/StableAndroid automatically"
                android:textColor="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPresets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Presets" />

                <Button
                    android:id="@+id/btnSavePreset"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save settings" />
            </LinearLayout>

            <!-- Prompt -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Label"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="Prompt" />

                <Button
                    android:id="@+id/btnDescribe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Describe image" />
            </LinearLayout>
            <EditText
                android:id="@+id/editPrompt"
                style="@style/Field"
                android:gravity="top"
                android:hint="what should appear in the masked area"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2" />

            <TextView style="@style/Label" android:text="Negative prompt" />
            <EditText
                android:id="@+id/editNegative"
                style="@style/Field"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="1" />

            <!-- Stylize-only -->
            <LinearLayout
                android:id="@+id/rowCreate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout style="@style/Cell" android:layout_weight="2">
                    <TextView style="@style/Label" android:text="Style" />
                    <Spinner android:id="@+id/spinStyle" style="@style/Spin" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cellTxtSize"
                    style="@style/Cell"
                    android:visibility="gone">
                    <TextView style="@style/Label" android:text="Size" />
                    <Spinner android:id="@+id/spinTxtSize" style="@style/Spin" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStylePhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photo" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkSharpen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="Sharpen faces (enlarge ×2, then redraw each face; slower)"
                android:textColor="#DDDDDD"
                android:visibility="gone" />

            <!-- Sampling -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Steps" />
                    <EditText android:id="@+id/editSteps" style="@style/Field" android:inputType="number" android:text="20" />
                </LinearLayout>

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="CFG" />
                    <EditText android:id="@+id/editCfg" style="@style/Field" android:inputType="numberDecimal" android:text="7" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cellStrength" style="@style/Cell">
                    <TextView style="@style/Label" android:text="Denoise" />
                    <EditText android:id="@+id/editStrength" style="@style/Field" android:inputType="numberDecimal" android:text="1.0" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout style="@style/Cell" android:layout_weight="2">
                    <TextView style="@style/Label" android:text="Seed (-1 = random)" />
                    <EditText android:id="@+id/editSeed" style="@style/Field" android:inputType="numberSigned" android:text="-1" />
                </LinearLayout>

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Images" />
                    <EditText android:id="@+id/editImages" style="@style/Field" android:inputType="number" android:text="3" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnLastSeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reuse last" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Sampler" />
                    <Spinner android:id="@+id/spinSampler" style="@style/Spin" />
                </LinearLayout>

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Scheduler" />
                    <Spinner android:id="@+id/spinScheduler" style="@style/Spin" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowInpaintSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout android:id="@+id/cellWorkSize" style="@style/Cell">
                    <TextView style="@style/Label" android:text="Working size" />
                    <Spinner android:id="@+id/spinSize" style="@style/Spin" />
                </LinearLayout>

                <LinearLayout android:id="@+id/cellArea" style="@style/Cell">
                    <TextView style="@style/Label" android:text="Inpaint area" />
                    <Spinner android:id="@+id/spinArea" style="@style/Spin" />
                </LinearLayout>
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkBlend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Only change the masked area (blend edges)"
                android:textColor="#DDDDDD" />

            <LinearLayout
                android:id="@+id/rowFeather"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txtFeather"
                    style="@style/Label"
                    android:layout_marginTop="0dp"
                    android:text="Edge feather" />

                <SeekBar
                    android:id="@+id/seekFeather"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="12" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkColorMatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Match colours to the surrounding area"
                android:textColor="#DDDDDD" />

            <!-- Model -->
            <TextView style="@style/Header" android:text="Model" />

            <TextView
                android:id="@+id/txtModel"
                style="@style/Label"
                android:text="No .safetensors chosen" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCheckpoints"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Checkpoints" />

                <Button
                    android:id="@+id/btnChooseModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pick file" />

                <Button
                    android:id="@+id/btnLoadModel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Load" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLora"
                style="@style/Label"
                android:text="LoRA: none" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnChooseLora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Choose LoRA" />

                <Button
                    android:id="@+id/btnClearLora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove" />

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Strength" />
                    <EditText android:id="@+id/editLoraStrength" style="@style/Field" android:inputType="numberDecimal" android:text="1.0" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/Label" android:text="Run on" />
            <Spinner android:id="@+id/spinCompute" style="@style/Spin" />

            <TextView
                android:id="@+id/txtDescribe"
                style="@style/Label"
                android:text="Describe model: not installed" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDescribeFiles"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Choose describe files" />

                <Button
                    android:id="@+id/btnDescribeRemove"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remove" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtDriver"
                style="@style/Label"
                android:text="GPU driver: system" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnInstallDriver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Install Turnip (.zip)" />

                <Button
                    android:id="@+id/btnRemoveDriver"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Use system driver" />
            </LinearLayout>

            <CheckBox
                android:id="@+id/chkGpuF32"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:text="GPU full precision (slower; try if images come out grey or black; applies after restart)"
                android:textColor="#DDDDDD" />

            <CheckBox
                android:id="@+id/chkGpuSafe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="GPU safe mode (avoids shaders some drivers can't build; applies after restart)"
                android:textColor="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Cell" android:layout_weight="2">
                    <TextView style="@style/Label" android:text="Weights in memory" />
                    <Spinner android:id="@+id/spinWeights" style="@style/Spin" />
                </LinearLayout>

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="Threads" />
                    <EditText android:id="@+id/editThreads" style="@style/Field" android:inputType="number" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout style="@style/Cell">
                    <TextView style="@style/Label" android:text="CLIP skip" />
                    <EditText android:id="@+id/editClipSkip" style="@style/Field" android:inputType="numberSigned" android:text="-1" />
                </LinearLayout>

                <LinearLayout style="@style/Cell" android:layout_weight="2">
                    <CheckBox
                        android:id="@+id/chkFlash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Flash attention"
                        android:textColor="#DDDDDD" />

                    <CheckBox
                        android:id="@+id/chkFastVae"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Fast VAE (TAESD)"
                        android:textColor="#DDDDDD" />

                    <CheckBox
                        android:id="@+id/chkTiling"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="Tiled VAE (less RAM)"
                        android:textColor="#DDDDDD" />

                    <CheckBox
                        android:id="@+id/chkMmap"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:text="Memory-map file"
                        android:textColor="#DDDDDD" />
                </LinearLayout>
            </LinearLayout>

            <!-- Log -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView style="@style/Header" android:layout_width="0dp" android:layout_weight="1" android:text="Log" />

                <Button
                    android:id="@+id/btnCopyLog"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Copy log" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0A0A0A"
                android:fontFamily="monospace"
                android:padding="6dp"
                android:textColor="#9E9E9E"
                android:textIsSelectable="true"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
